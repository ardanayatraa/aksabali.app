NEXT_PUBLIC_APP_URL=https://aksarabali.id
APP_URL=https://aksarabali.id

# Production MySQL. Use DATABASE_URL or discrete DB_* values.
DATABASE_URL=mysql://user:password@host:3306/aksarabaliku
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_AUTO_CREATE=true
DB_POOL_LIMIT=10

# Auth session.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_REGISTRATION_KEY=replace-with-private-admin-invite-code

# Supabase production project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans production or sandbox keys.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=true

# Voucher signing secret for server-side redeem validation.
VOUCHER_HMAC_SECRET=
